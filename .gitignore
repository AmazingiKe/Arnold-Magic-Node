# 本地 Codex 配置
/.codex/

# Python 字节码与缓存
__pycache__/
*.py[cod]
*$py.class

# Python 工具缓存
/.pytest_cache/
/.ruff_cache/
/.mypy_cache/
/.coverage
/htmlcov/

# 本地虚拟环境
/.venv/
/venv/
/env/

# 本地第三方库
/libs/

# 插件临时文件
/Temp/

# 旧版插件本地数据（新版本不读取、不写入、不自动迁移）
/Datas/

# 插件用户数据由 Maya 提供的用户目录管理，不进入仓库

# 通用日志与临时文件
*.log
*.tmp
*.bak

# 编辑器与操作系统文件
/.idea/
/.vscode/
.DS_Store
Thumbs.db
Desktop.ini
